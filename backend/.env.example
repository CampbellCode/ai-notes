# Copy this file to ".env" and fill in your values.
# The real .env is gitignored so your key never gets committed.

# Which AI provider to use: "cloud" or "local"
AI_PROVIDER=cloud

# --- Cloud (Anthropic) settings ---
# Get a key from the Anthropic Console. NOTE: this is the pay-as-you-go API,
# billed separately from any Claude.ai chat subscription.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
CLOUD_MODEL=claude-haiku-4-5

# --- Local (Ollama) settings ---
# Only used when AI_PROVIDER=local. No API key needed.
# localhost if backend runs on the same PC as Ollama;
# your PC's LAN IP on home wifi; your Tailscale IP when remote.
OLLAMA_HOST=http://localhost:11434
LOCAL_MODEL=llama3.1

# Backend port
PORT=3001
